{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbr.nshsystems.com/contracts/v1/coverage.schema.json",
  "title": "Harbr Protection Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "site_id",
    "tiers"
  ],
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "site_id": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "location",
          "current",
          "target",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "target": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "complete",
              "building",
              "warning",
              "failed"
            ]
          }
        }
      }
    }
  }
}
